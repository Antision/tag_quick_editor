<RCC>
    <qresource prefix="/">
        <file>../res/fonts/Ubuntu-Light.ttf</file>
        <file>../res/fonts/Ubuntu-Regular.ttf</file>
        <file>../res/fonts/Ubuntu-Bold.ttf</file>
        <file>../res/icon.ico</file>
        <file>../res/icon.png</file>
    </qresource>
    <!-- 图标:Lucide(ISC 许可,见 LICENSES/lucide-ISC.txt)。线条 SVG,
         stroke=currentColor,运行时由 common/ui/svgicon.h 着色渲染。
         旧的 PNG 图标(菜单/加号/垃圾桶/关闭最大化最小化/滚动条箭头)已全部
         删除:菜单与排序按钮用这里的 SVG,窗口三颗按钮由 WindowGlyphButton
         直接绘制,滚动条箭头换成 chevron-*.svg(见 list.qss)。 -->
    <qresource prefix="/icons">
        <file alias="arrow-down-a-z.svg">../res/icons/arrow-down-a-z.svg</file>
        <file alias="arrow-down-wide-narrow.svg">../res/icons/arrow-down-wide-narrow.svg</file>
        <file alias="check.svg">../res/icons/check.svg</file>
