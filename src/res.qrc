<RCC>
    <qresource prefix="/">
        <file>../res/fonts/Ubuntu-Light.ttf</file>
        <file>../res/fonts/Ubuntu-Regular.ttf</file>
        <file>../res/fonts/Ubuntu-Bold.ttf</file>
        <file>../res/bin.png</file>
        <file>../res/bin_sleep.png</file>
        <file>../res/close.png</file>
        <file>../res/close_mainwindow_sleep.png</file>
        <file>../res/close_sleep.png</file>
        <file>../res/icon.ico</file>
        <file>../res/icon.png</file>
        <file>../res/maximize.png</file>
        <file>../res/maximize_mainwindow_sleep.png</file>
        <file>../res/maximize_sleep.png</file>
        <file>../res/menu_add.png</file>
        <file>../res/menu_copy.png</file>
        <file>../res/menu_cut.png</file>
        <file>../res/menu_edit.png</file>
        <file>../res/menu_paste.png</file>
        <file>../res/menu_pin.png</file>
        <file>../res/menu_remove.png</file>
        <file>../res/minimize.png</file>
        <file>../res/minimize_mainwindow_sleep.png</file>
        <file>../res/minimize_sleep.png</file>
        <file>../res/plus.png</file>
        <file>../res/plus_sleep.png</file>
        <file>../res/scrollbar_downarrow.png</file>
        <file>../res/scrollbar_leftarrow.png</file>
        <file>../res/scrollbar_rightarrow.png</file>
        <file>../res/scrollbar_uparrow.png</file>
        <file>../res/tick.png</file>
        <file>../res/tick_sleep.png</file>
    </qresource>
    <!-- 样式表:用 teStyle::sheet("list") 取,见 src/testyle.h。
         alias 是必须的:资源名是 prefix + 相对 .qrc 的路径,直接写
         ../res/style/list.qss 会变成 :/style/res/style/list.qss。 -->
    <qresource prefix="/style">
        <file alias="list.qss">../res/style/list.qss</file>
        <file alias="editor.qss">../res/style/editor.qss</file>
        <file alias="editor_custom.qss">../res/style/editor_custom.qss</file>
        <file alias="controls.qss">../res/style/controls.qss</file>
    </qresource>
    <!-- 二级按钮的菜单界面(SC-10)。一个控件一个 .ui,文件名 = 控件 id + _menu;
         运行时用 QUiLoader 按 :/secondarymenu/<id>_menu.ui 取,不依赖外部文件。
         在 Designer 里可以直接打开这些文件改布局,代码那边只认按钮的 objectName
         (btn_<id> / chk_<id>),所以挪位置、改文字都不用动代码。 -->
    <qresource prefix="/secondarymenu">
        <file alias="quality_menu.ui">../res/secondarymenu/quality_menu.ui</file>
        <file alias="framing_menu.ui">../res/secondarymenu/framing_menu.ui</file>
        <file alias="facing_menu.ui">../res/secondarymenu/facing_menu.ui</file>
        <file alias="posture_menu.ui">../res/secondarymenu/posture_menu.ui</file>
        <file alias="angle_menu.ui">../res/secondarymenu/angle_menu.ui</file>
        <file alias="lighting_menu.ui">../res/secondarymenu/lighting_menu.ui</file>
        <file alias="scene_menu.ui">../res/secondarymenu/scene_menu.ui</file>
        <file alias="format_menu.ui">../res/secondarymenu/format_menu.ui</file>
        <file alias="expression_menu.ui">../res/secondarymenu/expression_menu.ui</file>
        <file alias="eye_menu.ui">../res/secondarymenu/eye_menu.ui</file>
        <file alias="eye_shape_menu.ui">../res/secondarymenu/eye_shape_menu.ui</file>
        <file alias="censor_menu.ui">../res/secondarymenu/censor_menu.ui</file>
        <file alias="trap_menu.ui">../res/secondarymenu/trap_menu.ui</file>
        <file alias="character_type_menu.ui">../res/secondarymenu/character_type_menu.ui</file>
        <file alias="faces_menu.ui">../res/secondarymenu/faces_menu.ui</file>
        <file alias="sexual_positions_menu.ui">../res/secondarymenu/sexual_positions_menu.ui</file>
    </qresource>
</RCC>
