    <!-- 样式表:用 teStyle::sheet("list") 取,见 src/testyle.h。
         alias 是必须的:资源名是 prefix + 相对 .qrc 的路径,直接写
         ../res/style/list.qss 会变成 :/style/res/style/list.qss。 -->
    <qresource prefix="/style">
        <file alias="list.qss">../res/style/list.qss</file>
        <file alias="scrollbar.qss">../res/style/scrollbar.qss</file>
        <file alias="editor.qss">../res/style/editor.qss</file>
        <file alias="editor_custom.qss">../res/style/editor_custom.qss</file>
        <file alias="controls.qss">../res/style/controls.qss</file>
        <file alias="secondarybutton.qss">../res/style/secondarybutton.qss</file>
    </qresource>
    <!-- 二级按钮的菜单界面(SC-10)。一个控件一个 .ui,文件名 = 控件 id + _menu;
         运行时用 QUiLoader 按 :/secondarymenu/<id>_menu.ui 取,不依赖外部文件。
         在 Designer 里可以直接打开这些文件改布局,代码那边只认按钮的 objectName
         (btn_<id> / chk_<id>),所以挪位置、改文字都不用动代码。 -->
